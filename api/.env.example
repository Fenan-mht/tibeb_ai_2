# Environment configuration
APP_ENV=test
AUTH_MODE=none

# Database URLs
# For dev/production (Supabase PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# For local automated testing (pgvector docker container)
TEST_DATABASE_URL=postgresql://postgres:test_password@localhost:5435/test_db

# Redis URL for job queue (RQ)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Groq free tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Voice / TTS (Google Cloud Text-to-Speech)
# Relative or absolute path to your downloaded service-account JSON key in api/secrets/
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-tts.json

# Payments (Chapa test key)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_test_secret_key_here
CHAPA_WEBHOOK_SECRET=your_webhook_secret_here

# Authentication & Security
JWT_SECRET=generate_a_random_32_byte_hex_secret_here
